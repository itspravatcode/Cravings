# Backend base URL (without /api). Copy to .env.local and restart with `npx expo start --clear`.
# Physical device: use your computer's LAN IP. Android emulator: http://10.0.2.2:8080
# Leave unset to auto-detect the host from the Metro dev server.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080

# Or just change the port (auto-detected host): EXPO_PUBLIC_API_PORT=8090
