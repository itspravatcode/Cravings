# Backend API configuration for the Cravings mobile app
#
# Copy this file to .env and update the values to match your setup.
#
# After changing this file, restart the Expo dev server:
#   npx expo start --clear
#
# Option 1: Set the full backend URL directly
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
#
# Replace 192.168.1.100 with your computer's LAN IP (run `hostname -I` or `ipconfig`).
# Make sure your backend is bound to 0.0.0.0 (not localhost) and port 8080 is open
# in your firewall so physical devices can reach it.
#
# Option 2: Leave EXPO_PUBLIC_API_URL unset and the app will auto-detect the host
# IP from the Metro dev server (works on physical devices & Expo Go without code
# changes, as long as the device is on the same Wi-Fi as your computer).