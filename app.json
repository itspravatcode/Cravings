{
  "expo": {
    "name": "Cravings",
    "slug": "Cravings",
    "version": "1.0.0",
    "scheme": "cravings",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.itspravat.cravings"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "in.itspravat.cravings"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F7801E",
          "defaultChannel": "activity"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1bd06e0a-4c5a-42b3-b02d-c3d6deb7cb1d"
      }
    },
    "owner": "pravatb"
  }
}
